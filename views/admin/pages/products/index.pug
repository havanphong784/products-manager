extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/filter-status
include ../../mixins/search
include ../../mixins/form-change-multi
include ../../mixins/pagination

block main
    .container.my-3
        +box-head('Bộ lọc sản phẩm')
        +search-box(keyword)
        +filter-status(filterStatus)
        +box-head('Danh sách sản phẩm')
        +form-change-multi(`${prefixAdmin}/products/change-multi?_method=PATCH`)
        .admin-table-wrapper
            table.admin-table( checkbox-multi )
                thead
                    tr
                        th
                            input(
                                type="checkbox"
                                name="checkAll"
                            )
                        th.th-thumb Ảnh
                        th.th-name Tên sản phẩm
                        th.th-desc Mô tả
                        th.th-price Giá
                        th.th-discount Giảm giá
                        th.th-status Trạng thái
                        th.th-actions Hành động
                tbody
                  each product in products
                      tr.table-row
                          td
                              input(
                                  type="checkbox"
                                  name="id"
                                  value=product.id
                              )
                          td.td-thumb
                              img(src=product.thumbnail, alt=product.title)
                          td.td-name #{product.title}
                          td.td-desc #{product.description}
                          td.td-price
                              span.price-new #{product.newPrice}$
                              br
                              span.price-old #{product.price}$
                          td.td-discount
                              span.badge-discount -#{product.discountPercentage}%
                          td.td-status
                              if product.status === 'active'
                                  a.badge.badge-success(
                                      href="javascript:;"
                                      button-change-status
                                      data-id=product.id
                                      data-status=product.status
                                  ) Hoạt động
                              else if product.status === 'inactive'
                                  a.badge.badge-inactive(
                                      href="javascript:;"
                                      button-change-status
                                      data-id=product.id
                                      data-status=product.status
                                  ) Không hoạt động
                              else
                                  span.badge.badge-default #{product.status || 'Chưa xác định'}
                          td.td-actions
                              a.btn-edit(href='#', title='Chỉnh sửa') Sửa
                              a.btn-delete(href='#', title='Xóa') Xóa
        +pagination(pagination)

    form(
        action=""
        method="POST"
        id="form-change-status"
        data-path= `${prefixAdmin}/products/change-status/`
    )

    script(src="/admin/js/product.js")