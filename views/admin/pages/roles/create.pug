extends ../../layouts/default.pug
include ../../mixins/alert

block main
    +alert-error(5000)
    .container-fluid.px-4.py-4
        .row.justify-content-center
            .col-xl-8.col-lg-10
                // Header
                .d-flex.align-items-center.justify-content-between.mb-4
                    div
                        h1.h3.font-weight-extrabold.text-dark.mb-1 Tạo nhóm quyền
                        p.text-muted.small.mb-0 Nhập thông tin để thêm nhóm quyền mới vào hệ thống
                    a.btn-back(href=`${prefixAdmin}/roles`)
                        span.mr-1 &larr;
                        | Quay lại danh sách

                // Form Card
                .admin-card
                    form(
                        action=`${prefixAdmin}/roles/create?_method=PATCH`
                        method="POST"
                    )
                        .form-group.mb-4
                            label.form-label(for="title") Tiêu đề
                            input.form-control-custom(
                                type="text"
                                id="title"
                                name="title"
                                placeholder="Nhập tiêu đề"
                                required
                            )

                        .form-group.mb-4
                            label.form-label(for="description") Mô tả ngắn
                            input.form-control-custom(
                                type="text"
                                id="    description"
                                name="description"
                                placeholder="Nhập mô tả"
                            )

                        // Actions
                        .form-actions.text-right.mt-4.pt-4.border-top
                            button.btn-submit(type="submit")
                                span Tạo mới
