extends ../../layouts/default.pug
include ../../mixins/alert

block main
    +alert-success(4000)
    +alert-error(4000)
    .container-fluid.px-4.py-4
        .d-flex.align-items-center.justify-content-between.mb-4
            div
                h1.h3.font-weight-extrabold.text-dark.mb-1 Nhóm quyền
                p.text-muted.small.mb-0 Quản lý danh sách các nhóm quyền
            if(role.permissions.includes("roles_create"))
                a.btn-create(href=`${prefixAdmin}/role/create`)
                    span.mr-1 +
                    | Thêm mới

        .admin-table-wrapper
            table.admin-table
                thead
                    tr
                        th(width="5%") STT
                        th.th-name(width="30%") Nhóm quyền
                        th.th-desc(width="40%") Mô tả ngắn
                        th.th-actions(width="25%") Hành động
                tbody
                        if roles && roles.length > 0
                          each item, index in roles
                              tr.table-row
                                  td #{index + 1}
                                  td.td-name #{item.title}
                                  td.td-desc #{item.description}
                                  td.td-actions
                                      a.btn-detail(href=`${prefixAdmin}/role/detail/${item.id}`, title='Chi tiết' data-id=item.id button-detail) Chi tiết
                                      if(role.permissions.includes("roles_edit"))
                                          a.btn-edit(href=`${prefixAdmin}/role/edit/${item.id}`, title='Chỉnh sửa') Sửa
                                      if(role.permissions.includes("roles_delete"))
                                          a.btn-delete(href='#', title='Xóa' data-id=item.id button-delete) Xóa
                        else
                            tr
                                td(colspan="4" class="text-center py-4") Chưa có nhóm quyền nào được tạo.

    form(
        action=""
        method="POST"
        id="form-delete-item"
        data-path=`${prefixAdmin}/role/delete/`
    )

    script(src="/admin/js/roles.js")
