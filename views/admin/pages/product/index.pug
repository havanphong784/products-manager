extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/filter-status
include ../../mixins/search
include ../../mixins/form-change-multi
include ../../mixins/pagination
include ../../mixins/alert
include ../../mixins/sort
include ../../mixins/moment

block main
    +alert-success(4000)
    .container.my-3
        +box-head('Tìm kiếm')
        .filter-container.mb-4
            .row.align-items-center
                .col-lg-7.col-md-12.mb-3.mb-lg-0.d-flex.align-items-center.flex-wrap
                    span.filter-label.mr-3.font-weight-bold.text-muted Trạng thái:
                    +filter-status(filterStatus)
                .col-lg-5.col-md-12
                    +search-box(keyword)

        +box-head('Bộ lọc')
        +sort()

        +box-head('Danh sách sản phẩm')
        .action-bar.mb-3.d-flex.align-items-center.justify-content-between
            if(role.permissions.includes("product_edit") || role.permissions.includes("product_delete"))
                +form-change-multi(`${prefixAdmin}/product/change-multi?_method=PATCH`)
            if(role.permissions.includes("product_create"))
                a.btn-create(href=`${prefixAdmin}/product/create`)
                    span.mr-1 +
                    | Thêm mới
        .admin-table-wrapper
            table.admin-table( checkbox-multi )
                thead
                    tr
                        th
                            input(
                                type="checkbox"
                                name="checkAll"
                            )
                        th.th-thumb STT
                        th.th-thumb Ảnh
                        th.th-name Tên sản phẩm
                        th.th-name Danh mục
                        th.th-desc Mô tả
                        th.th-price Giá
                        th Thứ tự
                        th.th-discount Giảm giá
                        th Người thêm
                        th Người sửa
                        th.th-status Trạng thái
                        th Nổi bật
                        th.th-actions Hành động
                tbody
                  each product,index in products
                      tr.table-row
                          td
                              input(
                                  type="checkbox"
                                  name="id"
                                  value=product.id
                              )
                          td #{pagination.limit * (pagination.currentPage - 1) + (index + 1)}
                          td.td-thumb
                              img(src=product.thumbnail, alt=product.title)
                          td.td-name #{product.title}
                          td.td-name #{product.category_name}
                          td.td-desc !{product.description}
                          td.td-price
                              span.price-new #{product.newPrice}$
                              br
                              span.price-old #{product.price}$
                          td
                              input(
                                  type="number"
                                  value=product.position
                                  style="width: 60px; text-align: center;"
                                  min="1"
                                  name="position"
                              )
                          td.td-discount
                              span.badge-discount -#{product.discountPercentage}%
                          td
                              div
                                if (product.createdBy)
                                    span #{product.accountFullName}
                                    +formatDate(product.createdBy.createdAt)
                          td
                            div
                                if (product.updatedBy && product.updatedBy.length > 0)
                                    - const updated = product.updatedBy.slice(-1)[0]
                                    span #{updated.accountFullName}
                                    +formatDateTime(updated.updatedAt)

                          td.td-status
                              if product.status === 'active'
                                  if(role.permissions.includes("product_edit"))
                                      a.badge.badge-success(
                                          href="javascript:;"
                                          button-change-status
                                          data-id=product.id
                                          data-status=product.status
                                      ) Hoạt động
                                  else
                                      span.badge.badge-success Hoạt động
                              else if product.status === 'inactive'
                                  if(role.permissions.includes("product_edit"))
                                      a.badge.badge-inactive(
                                          href="javascript:;"
                                          button-change-status
                                          data-id=product.id
                                          data-status=product.status
                                      ) Không hoạt động
                                  else
                                      span.badge.badge-inactive Không hoạt động
                              else
                                  span.badge.badge-default #{product.status || 'Chưa xác định'}
                          td
                              if product.featured == "1"
                                  span.badge.badge-warning Nổi bật
                          td.td-actions
                            if(role.permissions.includes("product_edit"))
                                a.btn-edit(href=`${prefixAdmin}/product/edit/${product.id}`, title='Chỉnh sửa') Sửa
                            if(role.permissions.includes("product_delete"))
                                a.btn-delete(href='#', title='Xóa' data-id=product.id button-delete) Xóa
                            a.btn-detail(href=`${prefixAdmin}/product/detail/${product.id}`, title='Chi tiết' data-id=product.id button-detail) Chi tiết
        +pagination(pagination)

    form(
        action=""
        method="POST"
        id="form-change-status"
        data-path= `${prefixAdmin}/product/change-status/`
    )

    form(
        action=""
        method="POST"
        id="form-delete-item"
        data-path= `${prefixAdmin}/product/delete/`
    )

    script(src="/admin/js/product.js")