extends ../../layouts/default
include ../../mixins/alert

block main
    h1 Cài đặt chung
    +alert-success(5000)
    +alert-error(5000)

    form(
        action=`${prefixAdmin}/setting/general?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
    )
        .form-group
            label(for="websiteName") Tên website
            input(
                type="text"
                class="form-control"
                id="websiteName"
                name="websiteName"
                value=(settingGeneral ? settingGeneral.websiteName : "")
            )
        .form-group(upload-image)
            label(for="logo") Logo
            input(
                type="file"
                class="form-control-file"
                id="logo"
                name="logo"
                accept="image/*"
                upload-preview-input
            )
            img(
                src=(settingGeneral ? settingGeneral.logo : "")
                class="image-preview"
                width="300px"
                upload-preview
            )
        .form-group
            label(for="phone") Số điện thoại
            input(
                type="text"
                class="form-control"
                id="phone"
                name="phone"
                value=(settingGeneral ? settingGeneral.phone : "")
            )
        .form-group
            label(for="email") Email
            input(
                type="email"
                class="form-control"
                id="email"
                name="email"
                value=(settingGeneral ? settingGeneral.email : "")
            )
        .form-group
            label(for="address") Địa chỉ
            input(
                type="text"
                class="form-control"
                id="address"
                name="address"
                value=(settingGeneral ? settingGeneral.address : "")
            )
        .form-group
            label(for="copyright") Copyright
            input(
                type="text"
                class="form-control"
                id="copyright"
                name="copyright"
                value=(settingGeneral ? settingGeneral.copyright : "")
            )
        .form-group
            button(
                type="submit"
                class="btn btn-primary"
            ) Cập nhật