extends ../../layouts/default.pug
include ../../mixins/alert

block main
    +alert-success(4000)
    +alert-error(4000)
    .container-fluid.px-4.py-4
        .d-flex.align-items-center.justify-content-between.mb-4
            div
                h1.h3.font-weight-extrabold.text-dark.mb-1 Quản lý tài khoản
                p.text-muted.small.mb-0 Quản lý danh sách các tài khoản quản trị
            if(role.permissions.includes("account_create"))
                a.btn-create(href=`${prefixAdmin}/account/create`)
                    span.mr-1 +
                    | Thêm mới

        .admin-table-wrapper
            table.admin-table
                thead
                    tr
                        th(width="5%") STT
                        th(width="10%") Avatar
                        th(width="20%") Họ tên
                        th(width="15%") Phân quyền
                        th(width="15%") Email
                        th(width="10%") Số điện thoại
                        th(width="10%") Trạng thái
                        th.th-actions(width="20%") Hành động
                tbody
                    if accounts && accounts.length > 0
                        each item, index in accounts
                            tr.table-row
                                td #{index + 1}
                                td
                                    if item.avatar
                                        img(src=item.avatar, alt=item.fullName, width="50", height="50", style="border-radius: 5px; object-fit: cover;")
                                    else
                                        img(src="/admin/images/avatar-default.jpg", alt="Default Avatar", width="50", height="50", style="border-radius: 5px; object-fit: cover;")
                                td.td-name #{item.fullName}
                                td #{item.role ? item.role.title : ""}
                                td #{item.email}
                                td #{item.phone}
                                td
                                    if (item.status === "active")
                                        span.badge.badge-success Hoạt động
                                    else
                                        span.badge.badge-danger Dừng hoạt động
                                td.td-actions
                                    a.btn-detail(href=`${prefixAdmin}/account/detail/${item.id}`, title='Chi tiết') Chi tiết
                                    if(role.permissions.includes("account_edit"))
                                        a.btn-edit(href=`${prefixAdmin}/account/edit/${item.id}`, title='Chỉnh sửa') Sửa
                                    if(role.permissions.includes("account_delete"))
                                        a.btn-delete(href='#', title='Xóa' data-id=item.id button-delete) Xóa
                    else
                        tr
                            td(colspan="7" class="text-center py-4") Chưa có tài khoản nào được tạo.
