doctype html
html
    head
        title #{pageTitle} | #{settingGeneral && settingGeneral.websiteName ? settingGeneral.websiteName : "Admin"}
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css")
        link(rel="preconnect", href="https://fonts.googleapis.com")
        link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap", rel="stylesheet")
        link(rel='stylesheet', href='/admin/css/style.css')
    body
        if (role.permissions.length > 0 )
            include ../partials/header.pug

            .admin-shell
                include ../partials/sidebar.pug

                main.admin-content
                    block main
        else
            h1 Không có quyền truy cập

        script(src='/admin/js/script.js')
        script(type="application/javascript" src="/tinymce/tinymce.min.js")
        script(src="/admin/js/my-tinymce-config.js")