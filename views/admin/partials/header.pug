header.header
    .container-fluid.px-4
        .inner-header
            .inner-logo
                a(href=`${prefixAdmin}/dashboard`)
                    if settingGeneral && settingGeneral.logo
                        img(src=settingGeneral.logo alt=(settingGeneral.websiteName ? settingGeneral.websiteName : "Admin Panel") style="max-height: 40px;")
                    else
                        span.logo-text #{settingGeneral && settingGeneral.websiteName ? settingGeneral.websiteName : "Admin"}
                        span.logo-dot Panel
            .inner-actions
                a.view-website-btn(href='/' target='_blank')
                    span.icon 🔗
                    span.text Xem Website
                .user-profile
                    a(href=`${prefixAdmin}/my-account`)
                        img.user-avatar(src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80', alt='Admin Avatar')
                    .user-info
                        span.user-name Phong Ha
                        span.user-role Quản trị viên
                    button
                        a(href=`${prefixAdmin}/auth/logout`) Đăng xuất