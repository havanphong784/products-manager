mixin table-tree(records,level=1)
  each item in records
    - const prefix = Array(level + 1).join("-- ")
    tr
        td #{item.index}
        td
            img(
                src=item.thumbnail
                alt=item.title
                width="80px"
                height="auto"
                style="border-radius: 8px; object-fit: cover;"
            )
        td #{prefix}#{item.title}
        td
            input(
                type="number"
                value=item.position
                style="width: 60px"
                min="1"
                name="position"
            )
        td
            if item.status == "active"
                a.badge.badge-success(href="javascript:;") Hoạt động
            else
                a.badge.badge-danger(href="javascript:;") Dừng hoạt động
        td
            if(role.permissions.includes("product-category_edit"))
                a.btn.btn-warning.btn-sm.mr-2(href=`${prefixAdmin}/product-category/edit/${item.id}`) Sửa
            if(role.permissions.includes("product-category_delete"))
                button.btn.btn-danger.btn-sm Xóa

    if item.children && item.children.length > 0
        +table-tree(item.children,level + 1)