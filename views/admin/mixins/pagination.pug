mixin pagination(pagination)
  if (pagination.totalPages > 1)
    nav.pagination-container
      ul.pagination-list
        if (pagination.currentPage > 1)
          li.pagination-item
            button.pagination-btn(button-pagination=1) Trang đầu
          li.pagination-item
            button.pagination-btn(button-pagination=pagination.currentPage - 1) Trước

        - for (var i = Math.max(1, pagination.currentPage - 2); i <= Math.min(pagination.totalPages, pagination.currentPage + 2); i++)
          li(class=`pagination-item ${pagination.currentPage === i ? 'active' : ''}`)
            button.pagination-btn(button-pagination=i) #{i}

        if (pagination.currentPage < pagination.totalPages)
          li.pagination-item
            button.pagination-btn(button-pagination=pagination.currentPage + 1) Sau
          li.pagination-item
            button.pagination-btn(button-pagination=pagination.totalPages) Trang cuối