extends ../../layouts/default.pug
include ../../mixins/alert

block main
  +alert-error(5000)
  +alert-success(5000)
  .container.my-5
    .row.justify-content-center
      .col-8
        h1.text-center Nhập mã OTP
        form(action="/user/password/otp" method="POST")
          .form-group
            label(for="email") Email
            input(type="email" class="form-control" value=email id="email" name="email" disabled readonly)
          .form-group
            label(for="otp") OTP
            input(type="text" class="form-control" id="otp" name="otp" required)
          .form-group
            button(type="submit" class="btn btn-primary btn-block") Xác nhận