extends ../../layouts/default.pug
include ../../mixins/alert

block main
  +alert-error(5000)
  +alert-success(5000)

  .auth-page.py-5
    .container
      .row.justify-content-center
        .col-lg-5.col-md-7
          .auth-card.bg-white.p-4.p-md-5.rounded-lg.shadow-sm
            .text-center.mb-4
              i.fa-solid.fa-shield-halved.text-primary.fa-3x.mb-3
              h3.font-weight-bold.text-dark Xác thực mã OTP
              p.text-muted.small Mã xác thực 8 chữ số đã được gửi tới email của bạn

            form(action="/user/password/otp", method="POST")
              .form-group.mb-3
                label.font-weight-semibold(for="email") Email
                .input-group
                  .input-group-prepend
                    span.input-group-text.bg-light
                      i.fa-solid.fa-envelope
                  input.form-control(type="email", value=email, id="email", name="email", readonly)

              .form-group.mb-4
                label.font-weight-semibold(for="otp") Mã OTP
                .input-group
                  .input-group-prepend
                    span.input-group-text.bg-light
                      i.fa-solid.fa-lock
                  input.form-control(type="text", id="otp", name="otp", placeholder="Nhập 8 chữ số OTP", required, maxlength="8")

              button.btn.btn-primary.btn-block.btn-lg.rounded-pill(type="submit")
                i.fa-solid.fa-check.mr-2
                | Xác nhận OTP

            .text-center.mt-4.pt-3.border-top
              span.text-muted.small Chưa nhận được mã?
              a.text-primary.font-weight-bold.small.ml-1(href="/user/password/forgot") Gửi lại mã
