extends ../../layouts/default.pug
include ../../mixins/alert

block main
  +alert-error(5000)
  +alert-success(5000)

  .auth-page.py-5
    .container
      .row.justify-content-center
        .col-lg-5.col-md-7
          .auth-card.bg-white.p-4.p-md-5.rounded-lg.shadow-sm
            .text-center.mb-4
              i.fa-solid.fa-key.text-primary.fa-3x.mb-3
              h3.font-weight-bold.text-dark Quên mật khẩu
              p.text-muted.small Nhập email đã đăng ký để nhận mã OTP lấy lại mật khẩu

            form(action="/user/password/forgot", method="POST")
              .form-group.mb-4
                label.font-weight-semibold(for="email") Địa chỉ Email
                .input-group
                  .input-group-prepend
                    span.input-group-text.bg-light
                      i.fa-solid.fa-envelope
                  input.form-control(type="email", id="email", name="email", placeholder="nhapemail@example.com", required)

              button.btn.btn-primary.btn-block.btn-lg.rounded-pill(type="submit")
                i.fa-solid.fa-paper-plane.mr-2
                | Gửi mã xác thực

            .text-center.mt-4.pt-3.border-top
              span.text-muted.small Nhớ mật khẩu rồi?
              a.text-primary.font-weight-bold.small.ml-1(href="/user/login") Đăng nhập lại
