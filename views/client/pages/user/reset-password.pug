extends ../../layouts/default.pug
include ../../mixins/alert

block main
  +alert-error(5000)
  +alert-success(5000)

  .auth-page.py-5
    .container
      .row.justify-content-center
        .col-lg-5.col-md-7
          .auth-card.bg-white.p-4.p-md-5.rounded-lg.shadow-sm
            .text-center.mb-4
              i.fa-solid.fa-lock-open.text-primary.fa-3x.mb-3
              h3.font-weight-bold.text-dark Thiết lập mật khẩu mới
              p.text-muted.small Nhập mật khẩu mới cho tài khoản của bạn

            form(action="/user/password/reset", method="POST")
              .form-group.mb-3
                label.font-weight-semibold(for="password") Mật khẩu mới
                .input-group
                  .input-group-prepend
                    span.input-group-text.bg-light
                      i.fa-solid.fa-lock
                  input.form-control(type="password", id="password", name="password", placeholder="••••••••", required)

              .form-group.mb-4
                label.font-weight-semibold(for="confirmPassword") Xác nhận mật khẩu mới
                .input-group
                  .input-group-prepend
                    span.input-group-text.bg-light
                      i.fa-solid.fa-lock
                  input.form-control(type="password", id="confirmPassword", name="confirmPassword", placeholder="••••••••", required)

              button.btn.btn-primary.btn-block.btn-lg.rounded-pill(type="submit")
                i.fa-solid.fa-check-double.mr-2
                | Đổi mật khẩu
