extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block head
    link(rel="stylesheet" type="text/css" href="https://unpkg.com/file-upload-with-preview/dist/style.css")
    link(rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.css")

block main
    .container.my-5
        .row
            .col-12
                +box-head('Chat')
        include ../../partials/list-btn-user
        .row
            .col-12
                if friends && friends.length > 0
                    .chat-friends-list
                        each friend in friends
                            include ../../partials/chat-friend-card.pug
                else
                    .text-center.py-5
                        p.text-muted Bạn chưa có bạn bè nào. Hãy kết bạn để bắt đầu trò chuyện!
                        a.btn.btn-primary(href="/users/not-friend") Tìm bạn bè

block script
    script(src="/socket.io/socket.io.js")
    script(src="/client/js/socket.js")
    script(src="/client/js/users.js")
