extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block head
    link(rel="stylesheet" type="text/css" href="https://unpkg.com/file-upload-with-preview/dist/style.css")
    link(rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.css")

block main
    .container.my-5
        .row
            .col-12
                +box-head('Chat')
        include ../../partials/list-btn-user
        .row
            .col-12
                if friends && friends.length > 0
                    .chat-friends-list
                        each friend in friends
                            include ../../partials/chat-friend-card.pug
                else
                    .text-center.py-5
                        p.text-muted Bạn chưa có bạn bè nào. Hãy kết bạn để bắt đầu trò chuyện!
                        a.btn.btn-primary(href="/users/not-friend") Tìm bạn bè

block script
    script(src="/socket.io/socket.io.js")
    script(src="/client/js/socket.js")
    script(src="/client/js/users.js")
    script.
        const myUserId = "#{user.id}";
        socket.on('SERVER_RETURN_MESSAGE', (data) => {
            const friendCard = document.querySelector(`.chat-friend-item[href="/chat/${data.roomChatId}"]`);
            if (friendCard) {
                let latestMessageDiv = friendCard.querySelector('.chat-friend-latest-message');
                if (!latestMessageDiv) {
                    latestMessageDiv = document.createElement('div');
                    latestMessageDiv.classList.add('chat-friend-latest-message', 'text-truncate');
                    latestMessageDiv.style.cssText = "font-size: 13px; color: #6c757d; max-width: 200px;";
                    
                    const infoDiv = friendCard.querySelector('.chat-friend-info');
                    const statusDiv = friendCard.querySelector('.chat-friend-status');
                    infoDiv.insertBefore(latestMessageDiv, statusDiv);
                }
                
                let text = "";
                if (data.userId === myUserId) {
                    text += "<span>Bạn: </span>";
                }
                
                if (data.content) {
                    text += data.content;
                } else if (data.images && data.images.length > 0) {
                    text += `Đã gửi ${data.images.length} ảnh`;
                }
                
                latestMessageDiv.innerHTML = text;
            }
        });
