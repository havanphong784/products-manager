extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
    .container.my-5
        .row
            .col-12
                +box-head('Chat')
        .row
            .col-12
                .chat-container
                    // Nơi hiển thị nội dung chat
                    .chat-body(my-id=user.id)
                        if chats.length > 0
                            each chat in chats
                                if (chat.userId == user.id)
                                    .inner-outgoing
                                        .inner-content #{chat.content}
                                else
                                    .inner-incoming
                                        .inner-name #{chat.infoUser.fullName}
                                        .inner-content #{chat.content}
                        else
                            p Chưa có tin nhắn nào.
                    
                    // Form nhập chat
                    .chat-footer.mt-3
                        form(id="form-chat" action="")
                            .input-group
                                input.form-control(type="text" placeholder="Nhập nội dung..." id="input-chat" autocomplete="off")
                                .input-group-append
                                    span.btn.btn-primary(chat-icon) Icon
                                    button.btn.btn-primary(type="submit") Gửi
    div(class="tooltip" role="tooltip")
        emoji-picker(class="light")

block script
    script(src="/socket.io/socket.io.js")
    script(src="/client/js/socket.js")
    script(type="module" src="/client/js/chat.js")
    script(type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js")