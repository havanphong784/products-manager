extends ../../layouts/default.pug

block main
    .container
        .row.justify-content-center.align-items-center(style="min-height: 60vh;")
            .col-md-8.text-center
                h1.display-1.font-weight-bold.text-danger 404
                h2.mb-4 Oops! Trang không tồn tại
                p.text-muted.mb-4 Có vẻ như trang bạn đang tìm kiếm không tồn tại, đã bị xóa hoặc tạm thời không truy cập được.
                a.btn.btn-primary.btn-lg(href="/") Trở về trang chủ
