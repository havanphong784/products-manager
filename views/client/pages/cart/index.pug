extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/product-layout

block main
    .container.my-5
        .row.mb-4
            .col-12
                +box-head(pageTitle)
        
        .row
            .col-12
                if (cart.products && cart.products.length > 0)
                    .table-responsive.shadow-sm.rounded
                        table.table.table-hover.cart-table.align-middle.mb-0
                            thead.table-light
                                tr
                                    th.text-center STT
                                    th Ảnh
                                    th Tên sản phẩm
                                    th Giá
                                    th.text-center Số lượng
                                    th Tổng tiền
                                    th.text-center Hành động
                            tbody
                                each item, index in cart.products
                                    tr
                                        td.text-center #{index +1}
                                        td
                                            img(src=item.productInfo.thumbnail alt=item.productInfo.title width="80px" class="img-thumbnail rounded")
                                        td
                                            a.product-title-link(href=`/products/detail/${item.productInfo.slug}`) #{item.productInfo.title}
                                        td.fw-bold.text-danger #{item.productInfo.priceNew}$
                                        td.text-center
                                            input.form-control.cart-quantity-input.mx-auto(type="number" value=item.quantity min="1" max=item.productInfo.stock)
                                        td.fw-bold #{(item.productInfo.priceNew * item.quantity).toFixed(2)}$
                                        td.text-center
                                            a.btn.btn-sm.btn-outline-danger(href=`/cart/delete/${item.productId}`) 
                                                i.fas.fa-trash-alt
                                                |  Xóa
                    
                    .cart-summary.mt-4.p-4.bg-light.rounded.shadow-sm.text-end
                        h4.mb-3 Tổng đơn hàng: 
                            span.text-danger.fw-bold #{cart.totalPrice ? cart.totalPrice.toFixed(2) : 0}$
                        a.btn.btn-checkout.btn-lg(href="/checkout") TIẾN HÀNH THANH TOÁN
                else
                    .empty-cart-container.text-center.py-5
                        img.mb-3(src="/images/empty-cart.png" alt="Empty Cart" width="150px")
                        h4.text-muted Giỏ hàng của bạn đang trống!
                        a.btn.btn-primary.mt-3(href="/product") Tiếp tục mua sắm
