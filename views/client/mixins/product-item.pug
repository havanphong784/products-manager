mixin product-item(product)
    a(href=`/product/detail/${product.slug}`).product-item
        .inner-image
            img(src=product.thumbnail, alt=product.title)
            if product.discountPercentage
                .inner-discount -#{product.discountPercentage}%
        .inner-content
            h3.inner-title #{product.title}
            p.inner-description !{product.description}
        .inner-price-group
            span.inner-price-new #{product.newPrice}$
            if product.discountPercentage
                span.inner-price-old #{product.price}$
