include ../mixins/sub-menu.pug

header.header
    .header-wrapper
        .container
            .inner-header
                .inner-logo
                    a(href='/')
                        if settingGeneral && settingGeneral.logo
                            img(src=settingGeneral.logo alt=(settingGeneral.websiteName ? settingGeneral.websiteName : "Store"))
                        else
                            i.fa-solid.fa-store.logo-icon.mr-2
                            span.logo-text #{settingGeneral && settingGeneral.websiteName ? settingGeneral.websiteName : "Store"}
                            span.logo-dot .

                .inner-search
                    form(action="/search", method="GET", class="search-form")
                        .input-group
                            input.form-control(
                                type="text",
                                placeholder="Tìm kiếm sản phẩm...",
                                name="keyword",
                                value=keyword,
                                autocomplete="off"
                            )
                            .input-group-append
                                button.btn.btn-search(type="submit")
                                    i.fa-solid.fa-magnifying-glass

                .inner-menu
                    nav
                        ul
                            li
                                a(href='/' class=(activePage === 'home' ? 'active' : ''))
                                    i.fa-solid.fa-house.mr-1
                                    | Trang chủ
                            li(class="sub-menu")
                                a(href='/product' class=(activePage === 'products' ? 'active' : ''))
                                    i.fa-solid.fa-box-open.mr-1
                                    | Sản phẩm
                                    i.fa-solid.fa-chevron-down.ml-1.sub-icon
                                +sub-menu(category, "/product")
                            li
                                a(href='/chat' class=(activePage === 'chat' ? 'active' : ''))
                                    i.fa-solid.fa-comments.mr-1
                                    | Tin nhắn

                .inner-actions
                    a(href='/cart', class='btn-action-icon btn-cart', title="Giỏ hàng")
                        i.fa-solid.fa-cart-shopping
                        span.cart-count #{miniCart ? miniCart.totalQuantity : 0}

                    if (user)
                        .user-dropdown.d-inline-block
                            a(href="/user/info", class="btn-action-user")
                                i.fa-solid.fa-circle-user.mr-1
                                span #{user.fullName}
                            a(href="/user/logout", class="btn-action-outline ml-2", title="Đăng xuất")
                                i.fa-solid.fa-right-from-bracket
                    else
                        a(href="/user/login", class="btn-action-outline") Đăng nhập
                        a(href="/user/register", class="btn-action-primary") Đăng ký

                    a(href='/admin/product', class='btn-action-admin', title="Quản trị")
                        i.fa-solid.fa-sliders.mr-1
                        span Admin

                    button.mobile-nav-toggle(type="button" aria-label="Toggle navigation" id="btn-mobile-nav")
                        i.fa-solid.fa-bars
