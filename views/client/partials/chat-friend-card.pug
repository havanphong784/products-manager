if friend.roomChatId
    a.chat-friend-item(href=`/chat/${friend.roomChatId}` data-id=friend._id)
        .chat-friend-avatar(data-user-id=friend._id)
            img(
                src=(friend.avatar ? friend.avatar : "https://phukiennillkin.com/wp-content/uploads/2026/03/avatar-mac-dinh-facebook-8.jpg")
                alt=friend.fullName
            )
            span.status-indicator.offline
        .chat-friend-info
            .chat-friend-name #{friend.fullName}
            if friend.latestMessage
                .chat-friend-latest-message.text-truncate(style="font-size: 13px; color: #6c757d; max-width: 200px;")
                    if friend.latestMessage.userId === user.id
                        span Bạn: 
                    if friend.latestMessage.content
                        | #{friend.latestMessage.content}
                    else if friend.latestMessage.images && friend.latestMessage.images.length > 0
                        | Đã gửi #{friend.latestMessage.images.length} ảnh
            .chat-friend-status.inner-status.text-muted(data-last-online=(friend.lastOnline ? friend.lastOnline.toISOString() : "")) 
        .chat-friend-action
            span.btn.btn-sm.btn-primary Nhắn tin
