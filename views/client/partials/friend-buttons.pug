if status === 'not_friend'
  button(
    class="btn btn-sm btn-primary"
    button-add-friend=userId
  ) Kết bạn
else if status === 'sent_request'
  button(
    class="btn btn-sm btn-warning"
    button-cancel-friend=userId
  ) Hủy yêu cầu
else if status === 'received_request'
  button(
    class="btn btn-sm btn-success"
    button-accept-friend=userId
  ) Chấp nhận
  button(
    class="btn btn-sm btn-danger ml-1"
    button-refuse-friend=userId
  ) Từ chối
else if status === 'friend'
  if roomChatId
    a(
      class="btn btn-sm btn-primary mr-1"
      href=`/chat/${roomChatId}`
    ) Nhắn tin
  button(
    class="btn btn-sm btn-info"
    disabled
  ) Bạn bè
  button(
    class="btn btn-sm btn-secondary ml-1"
    button-unfriend=userId
  ) Xóa kết bạn