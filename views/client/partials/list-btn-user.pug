.row
    .col-12
        .user-menu-buttons
            a(
                class="btn-menu"
                href="/chat"
            ) Tin nhắn
            a(
                class="btn-menu"
                href="/chat/community"
            ) Thế giới
            a(
                class="btn-menu"
                href="/users/not-friend"
            ) Danh sách người dùng
            a(
                class="btn-menu"
                href="/users/friends"
            ) Danh sách bạn bè
            a(
                class="btn-menu"
                href="/users/request"
            ) Lời mời đã gửi
            a(
                class="btn-menu"
                href="/users/accept"
            )
                | Lời mời kết bạn
                span(
                    class="badge badge-light ml-1"
                    badge-users-accept=user.acceptFriends ? user.acceptFriends.length : 0
                ) #{user.acceptFriends ? user.acceptFriends.length : 0}